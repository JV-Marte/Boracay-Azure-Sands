# ============================================================================
# Azure Sands Boracay Condotel — environment variables
# Copy to .env.local and fill in. EVERYTHING here is optional for local dev:
# without Supabase config the app runs on an in-memory demo store.
# ============================================================================

# ---- Site --------------------------------------------------------------------
# Public URL of the deployed site (used for SEO, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps embed for the Location/Contact sections
# Get one: Google Maps -> search address -> Share -> Embed a map -> copy the src URL
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# ---- Supabase (database) -------------------------------------------------
# Create a project at https://supabase.com, then run supabase/schema.sql and
# supabase/seed.sql in the SQL editor. Values live in Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for bookings/admin writes when Supabase is configured.
# NEVER expose this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin dashboard -------------------------------------------------------
# Login for /admin. Defaults to demo credentials when unset (see README).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Long random string used to sign admin session cookies (required in production)
# Generate: openssl rand -base64 32
AUTH_SECRET=

# ---- Email (Resend) ----------------------------------------------------------
# https://resend.com — free tier is fine. Without a key, confirmation emails
# are logged to the server console instead of sent.
RESEND_API_KEY=
# Verified sender, e.g. "Azure Sands <stay@yourdomain.com>"
EMAIL_FROM=

# ---- Payments (future integration) -----------------------------------------
# Payment methods are placeholders in this build; bookings store the chosen
# method with payment_status=pending. Wire up Stripe/PayMongo here later.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
